---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Behind the Door — A Podcast for the Trades',
  description = 'The stories they never put on the highlight reel. Behind the Door is the podcast for the technician grinding right now, the business owner figuring it out alone, and everyone who was told the trades weren\'t good enough.',
  ogImage = '/og-default.jpg',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://btdpodcast.net');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />

    <!-- OG / Social -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.toString()} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="canonical" href={canonicalUrl.toString()} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Behind the Door Podcast" href="https://feeds.transistor.fm/behind-the-door" />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    /* ---- Brand palette ---- */
    --slate: #3a606e;        /* Blue Slate   */
    --slate-grey: #607b7d;   /* Slate Grey   */
    --olive: #828e82;        /* Grey Olive   */
    --sage: #aaae8e;         /* Dry Sage     */
    --alabaster: #e0e0e0;    /* Alabaster    */

    /* ---- Surfaces (deep slate, derived from Blue Slate) ---- */
    --bg: #0f1518;
    --bg-alt: #141d21;
    --surface: #1a252b;
    --surface-2: #202c33;
    --border: #2a383f;
    --border-strong: #3a606e;

    /* ---- Text (all pass WCAG AA) ---- */
    --text: #e0e0e0;         /* 13.9:1 */
    --text-2: #b4bcb4;       /*  9.6:1 */
    --text-dim: #828e82;     /*  5.4:1 */

    /* ---- Accent = Dry Sage ---- */
    --accent: #aaae8e;
    --accent-light: #c4c7ac;
    --accent-dim: #828e82;
    --accent-soft: rgba(170, 174, 142, 0.12);
    --accent-border: rgba(170, 174, 142, 0.45);
    --accent-gradient: linear-gradient(135deg, #aaae8e 0%, #c4c7ac 100%);
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    background: var(--bg);
    color: var(--text);
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--bg);
  }

  main {
    flex: 1;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  a { color: inherit; }

  /* Utility: chrome metallic text */
  .chrome-text {
    color: var(--text);
  }

  /* BTD logo mark used as a placeholder/decorative image.
     No percentage max-width: these sit inside shrink-to-fit flex items,
     where a percentage would create a circular size dependency and
     collapse the image to 0x0. The width attribute sets the size. */
  .btd-mark {
    height: auto;
    object-fit: contain;
  }

  /* Utility: chrome button */
  .btn-chrome {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--accent-gradient);
    color: var(--bg);
    font-weight: 800;
    font-size: 0.9rem;
    border: none;
    border-radius: 100px;
    text-decoration: none;
    cursor: pointer;
    font-family: inherit;
    transition: opacity 0.2s, transform 0.15s;
  }

  .btn-chrome:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  /* Section spacing utility */
  .section-pad {
    padding: 5rem 1.5rem;
  }

  /* Noise texture utility */
  .noise-overlay {
    position: relative;
  }

  .noise-overlay::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 180px;
    pointer-events: none;
  }

  /* Scrollbar */
  ::-webkit-scrollbar { width: 8px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
  ::-webkit-scrollbar-thumb:hover { background: var(--slate-grey); }
</style>
