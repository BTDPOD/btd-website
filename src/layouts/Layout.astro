---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Behind the Door — A Podcast for the Trades',
  description = 'The stories they never put on the highlight reel. Behind the Door is the podcast for the technician grinding right now, the business owner figuring it out alone, and everyone who was told the trades weren\'t good enough.',
  ogImage = '/og-default.jpg',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://btdpodcast.net');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />

    <!-- OG / Social -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.toString()} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="canonical" href={canonicalUrl.toString()} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Behind the Door Podcast" href="https://feeds.transistor.fm/behind-the-door" />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --accent: #f59132;
    --accent-light: #ffc94d;
    --accent-dim: #d9a955;
    --accent-soft: rgba(245, 145, 50, 0.12);
    --accent-border: rgba(245, 145, 50, 0.45);
    --accent-gradient: linear-gradient(135deg, #f59132 0%, #ffc94d 100%);
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    background: #1a1c1e;
    color: #e0e2e4;
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: #1a1c1e;
  }

  main {
    flex: 1;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  a { color: inherit; }

  /* Utility: chrome metallic text */
  .chrome-text {
    color: #d0d4d8;
  }

  /* Utility: chrome button */
  .btn-chrome {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: linear-gradient(135deg, #c0c0c0 0%, #e8e8e8 25%, #a8a8a8 50%, #d4d4d4 75%, #b8b8b8 100%);
    color: #1a1c1e;
    font-weight: 800;
    font-size: 0.9rem;
    border: none;
    border-radius: 8px;
    text-decoration: none;
    cursor: pointer;
    font-family: inherit;
    transition: opacity 0.2s, transform 0.15s;
  }

  .btn-chrome:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  /* Section spacing utility */
  .section-pad {
    padding: 5rem 1.5rem;
  }

  /* Noise texture utility */
  .noise-overlay {
    position: relative;
  }

  .noise-overlay::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 180px;
    pointer-events: none;
  }

  /* Scrollbar */
  ::-webkit-scrollbar { width: 8px; }
  ::-webkit-scrollbar-track { background: #1a1c1e; }
  ::-webkit-scrollbar-thumb { background: #3a3c3e; border-radius: 4px; }
  ::-webkit-scrollbar-thumb:hover { background: #5a5e62; }
</style>
