---
import PlatformBadge from './PlatformBadge.astro';
---

<section class="hero">
  <video
    class="hero-video"
    src="/video/hero-montage.mp4"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"
    tabindex="-1"
  ></video>
  <div class="hero-video-scrim"></div>
  <div class="hero-noise"></div>
  <div class="hero-inner">
    <span class="eyebrow">Real Talk for the Trades</span>
    <h1 class="hero-headline chrome-text">
      No fluff. No corporate BS.<br class="br-lg" /> Just the truth.
    </h1>
    <p class="hero-sub">
      The podcast for the technician grinding right now and the owner figuring it out
      alone. Host Kaleb Blyton sits down with the people who built something real.
    </p>
    <div class="hero-ctas">
      <a href="/episodes" class="btn-chrome-lg">Start Listening</a>
      <a href="/episodes" class="btn-outline-lg">Browse All Episodes</a>
    </div>
    <div class="platform-pills">
      <span class="pills-label">Available on</span>
      <PlatformBadge platform="apple" size="sm" />
      <PlatformBadge platform="spotify" size="sm" />
      <PlatformBadge platform="youtube" size="sm" />
      <PlatformBadge platform="amazon" size="sm" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: linear-gradient(160deg, var(--bg) 0%, var(--bg-alt) 50%, var(--bg-alt) 100%);
    padding: 7rem 1.5rem 6rem;
    overflow: hidden;
    min-height: 82vh;
    display: flex;
    align-items: center;
  }

  /* Background montage video */
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%;
    opacity: 0.8;
    pointer-events: none;
    z-index: 0;
  }

  /* Scrim keeps headline legible over the footage */
  .hero-video-scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 70% 60% at 50% 45%, rgba(15,21,24,0.72) 0%, rgba(15,21,24,0.45) 55%, transparent 100%),
      linear-gradient(180deg, rgba(15,21,24,0.55) 0%, rgba(15,21,24,0.25) 35%, rgba(15,21,24,0.6) 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video { display: none; }
  }

  /* Grain/noise overlay */
  .hero-noise {
    position: absolute;
    inset: 0;
    opacity: 0.035;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 180px;
    pointer-events: none;
  }

  /* Subtle radial glow */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(224,224,224,0.04) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 1120px;
    width: 100%;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
  }

  .eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sage);
    background: rgba(58, 96, 110, 0.35);
    border: 1px solid var(--slate);
    padding: 0.4em 1.2em;
    border-radius: 100px;
  }

  .hero-headline {
    font-size: clamp(1.8rem, 6.4vw, 4.6rem);
    font-weight: 900;
    line-height: 1.06;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    margin: 0;
    text-wrap: balance;
    width: 100%;
  }

  .hero-sub {
    color: var(--text-2);
    font-size: clamp(0.95rem, 2.2vw, 1.1rem);
    line-height: 1.7;
    max-width: 740px;
    margin: 0;
    text-wrap: pretty;
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-chrome-lg {
    padding: 0.875rem 2rem;
    background: var(--accent-gradient);
    color: var(--bg);
    font-weight: 800;
    font-size: 1rem;
    border-radius: 100px;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.15s;
    letter-spacing: -0.01em;
  }

  .btn-chrome-lg:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .btn-outline-lg {
    padding: 0.875rem 2rem;
    border: 1px solid var(--accent-border);
    color: var(--accent-dim);
    font-weight: 700;
    font-size: 1rem;
    border-radius: 100px;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s, transform 0.15s;
  }

  .btn-outline-lg:hover {
    border-color: var(--accent);
    color: var(--accent-light);
    transform: translateY(-2px);
  }

  .platform-pills {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .pills-label {
    font-size: 0.75rem;
    color: var(--slate-grey);
    font-weight: 500;
    margin-right: 0.25rem;
  }

  .br-lg { display: none; }

  @media (min-width: 640px) {
    .br-lg { display: block; }
  }

  @media (max-width: 480px) {
    .hero { padding: 5rem 1.25rem 4rem; }
    .hero-ctas { flex-direction: column; align-items: stretch; }
    .btn-chrome-lg, .btn-outline-lg { text-align: center; }
  }
</style>
