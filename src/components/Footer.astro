---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <!-- Brand column -->
      <div class="footer-brand">
        <a href="/" class="footer-logo-link" aria-label="Behind the Door Home">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="52" height="52" aria-hidden="true">
            <defs>
              <radialGradient id="ftCircleGrad" cx="50%" cy="35%" r="65%">
                <stop offset="0%" stop-color="#2a2a2a"/>
                <stop offset="100%" stop-color="#0a0a0a"/>
              </radialGradient>
              <linearGradient id="ftChromeBorder" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#c0c0c0"/>
                <stop offset="50%" stop-color="#e8e8e8"/>
                <stop offset="100%" stop-color="#b8b8b8"/>
              </linearGradient>
              <linearGradient id="ftChromeText" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#c0c0c0"/>
                <stop offset="30%" stop-color="#ffffff"/>
                <stop offset="60%" stop-color="#a8a8a8"/>
                <stop offset="100%" stop-color="#d4d4d4"/>
              </linearGradient>
            </defs>
            <circle cx="50" cy="50" r="48" fill="url(#ftChromeBorder)"/>
            <circle cx="50" cy="50" r="44" fill="url(#ftCircleGrad)"/>
            <text x="50" y="50" text-anchor="middle" dominant-baseline="middle"
                  font-family="Arial Black, Arial, sans-serif" font-weight="900"
                  font-size="22" fill="url(#ftChromeText)" letter-spacing="1">BTD</text>
            <g stroke="url(#ftChromeText)" stroke-width="1.5" opacity="0.7">
              <line x1="22" y1="64" x2="78" y2="64"/>
              <line x1="22" y1="69" x2="78" y2="69"/>
              <line x1="22" y1="74" x2="78" y2="74"/>
              <line x1="37" y1="64" x2="37" y2="74"/>
              <line x1="50" y1="64" x2="50" y2="74"/>
              <line x1="63" y1="64" x2="63" y2="74"/>
            </g>
          </svg>
        </a>
        <div>
          <div class="footer-show-name">Behind the Door</div>
          <div class="footer-tagline">The stories they never put on the highlight reel.</div>
        </div>
        <!-- Social links -->
        <div class="footer-socials">
          <a href="https://instagram.com/behindthedoorpod" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
            </svg>
            <span>@behindthedoorpod</span>
          </a>
          <a href="https://tiktok.com/@behindthedoorpod" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="TikTok">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.28 6.28 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.24 8.24 0 0 0 4.84 1.56V6.81a4.85 4.85 0 0 1-1.07-.12z"/>
            </svg>
            <span>@behindthedoorpod</span>
          </a>
        </div>
      </div>

      <!-- Nav columns -->
      <div class="footer-nav-columns">
        <div class="footer-col">
          <h4>Listen</h4>
          <a href="/episodes">All Episodes</a>
          <a href="/subscribe">Apple Podcasts</a>
          <a href="/subscribe">Spotify</a>
          <a href="/subscribe">YouTube</a>
          <a href="https://feeds.transistor.fm/behind-the-door" target="_blank" rel="noopener">RSS Feed</a>
        </div>
        <div class="footer-col">
          <h4>Show</h4>
          <a href="/about">About</a>
          <a href="/guests">Guests</a>
          <a href="/contact">Contact</a>
          <a href="/subscribe">Subscribe</a>
        </div>
        <div class="footer-col">
          <h4>Connect</h4>
          <a href="https://instagram.com/behindthedoorpod" target="_blank" rel="noopener">Instagram</a>
          <a href="https://tiktok.com/@behindthedoorpod" target="_blank" rel="noopener">TikTok</a>
          <a href="/contact">Be a Guest</a>
          <a href="/contact">Sponsorships</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">&copy; {year} Behind the Door. All rights reserved.</p>
      <div class="footer-legal">
        <a href="/privacy">Privacy Policy</a>
        <span class="sep">|</span>
        <a href="/terms">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #16181a;
    border-top: 1px solid #2e3032;
    margin-top: auto;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem 1.5rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid #2e3032;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-logo-link { display: inline-block; }

  .footer-show-name {
    font-size: 1.1rem;
    font-weight: 800;
    background: linear-gradient(135deg, #c0c0c0 0%, #ffffff 20%, #a8a8a8 40%, #e8e8e8 60%, #909090 80%, #d4d4d4 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .footer-tagline {
    color: #6a6e72;
    font-size: 0.875rem;
    font-style: italic;
    margin-top: 0.25rem;
  }

  .footer-socials {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-top: 0.5rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #8a8e92;
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s;
  }

  .social-link:hover { color: #c0c0c0; }

  .footer-nav-columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .footer-col h4 {
    color: #c0c0c0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 1rem;
  }

  .footer-col a {
    display: block;
    color: #6a6e72;
    text-decoration: none;
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
    transition: color 0.2s;
  }

  .footer-col a:hover { color: #c0c0c0; }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-copy {
    color: #4a4e52;
    font-size: 0.8rem;
    margin: 0;
  }

  .footer-legal {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8rem;
  }

  .footer-legal a {
    color: #4a4e52;
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-legal a:hover { color: #8a8e92; }
  .sep { color: #3a3e42; }

  @media (max-width: 768px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-nav-columns {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 480px) {
    .footer-nav-columns {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
