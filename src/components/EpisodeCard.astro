---
import type { Episode } from '../lib/rss';
import { formatDate, formatDuration } from '../lib/rss';

interface Props {
  episode?: Episode;
  placeholder?: boolean;
  index?: number;
  image?: string;
  title?: string;
  label?: string;
  desc?: string;
  href?: string;
}

const { episode, placeholder = false, index = 0, image, title, label, desc, href } = Astro.props;
---

{placeholder ? (
  <article class={`episode-card ${image ? '' : 'placeholder-card'}`}>
    {image ? (
      <div class="card-thumb-link">
        <img src={image} alt={title ?? 'Behind the Door episode'} class="card-thumb-img" loading="lazy" width="300" height="300" />
      </div>
    ) : (
      <div class="card-thumb placeholder-thumb">
        <div class="thumb-inner">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="60" height="60" aria-hidden="true">
            <defs>
              <linearGradient id={`phChrome${index}`} x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#b4bcb4"/>
                <stop offset="50%" stop-color="#e0e0e0"/>
                <stop offset="100%" stop-color="#828e82"/>
              </linearGradient>
            </defs>
            <circle cx="50" cy="50" r="48" fill={`url(#phChrome${index})`}/>
            <circle cx="50" cy="50" r="44" fill="#111"/>
            <text x="50" y="50" text-anchor="middle" dominant-baseline="middle"
                  font-family="Arial Black" font-weight="900" font-size="22"
                  fill={`url(#phChrome${index})`} letter-spacing="1">BTD</text>
          </svg>
        </div>
      </div>
    )}
    <div class="card-body">
      <span class="ep-label">{label ?? 'Coming Soon'}</span>
      <h3 class="ep-title chrome-text">{title ?? 'Episode Dropping Soon'}</h3>
      <p class="ep-desc">{desc ?? "New episodes are coming. Subscribe so you don't miss the first drop."}</p>
      <a href={href ?? '/subscribe'} class="btn-outline-sm">{href ? 'Learn More' : 'Subscribe Now'}</a>
    </div>
  </article>
) : episode ? (
  <article class="episode-card">
    <a href={`/episodes/${episode.slug}`} class="card-thumb-link">
      {episode.image ? (
        <img
          src={episode.image}
          alt={episode.title}
          class="card-thumb-img"
          loading="lazy"
          width="300"
          height="300"
        />
      ) : (
        <div class="card-thumb placeholder-thumb">
          <div class="thumb-inner">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="60" height="60" aria-hidden="true">
              <defs>
                <linearGradient id={`epChrome${index}`} x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#b4bcb4"/>
                  <stop offset="50%" stop-color="#e0e0e0"/>
                  <stop offset="100%" stop-color="#828e82"/>
                </linearGradient>
              </defs>
              <circle cx="50" cy="50" r="48" fill={`url(#epChrome${index})`}/>
              <circle cx="50" cy="50" r="44" fill="#111"/>
              <text x="50" y="50" text-anchor="middle" dominant-baseline="middle"
                    font-family="Arial Black" font-weight="900" font-size="22"
                    fill={`url(#epChrome${index})`} letter-spacing="1">BTD</text>
            </svg>
          </div>
        </div>
      )}
    </a>
    <div class="card-body">
      <div class="card-meta">
        {episode.episodeNumber && <span class="ep-label">Episode {episode.episodeNumber}</span>}
        {episode.pubDate && <span class="ep-date">{formatDate(episode.pubDate)}</span>}
        {episode.duration && <span class="ep-dur">{formatDuration(episode.duration)}</span>}
      </div>
      <h3 class="ep-title">
        <a href={`/episodes/${episode.slug}`} class="ep-title-link chrome-text">{episode.title}</a>
      </h3>
      {episode.description && (
        <p class="ep-desc">{episode.description.slice(0, 140)}{episode.description.length > 140 ? '…' : ''}</p>
      )}
      <a href={`/episodes/${episode.slug}`} class="btn-outline-sm">Listen &rarr;</a>
    </div>
  </article>
) : null}

<style>
  .episode-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.25s, transform 0.2s;
  }

  .episode-card:hover {
    border-color: var(--accent-border);
    box-shadow: 0 6px 24px rgba(170, 174, 142, 0.1);
    transform: translateY(-2px);
  }

  .placeholder-card {
    border-style: dashed;
    border-color: var(--border);
  }

  .card-thumb-link {
    display: block;
    aspect-ratio: 2 / 1;
    overflow: hidden;
  }

  .card-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .episode-card:hover .card-thumb-img {
    transform: scale(1.04);
  }

  .placeholder-thumb {
    aspect-ratio: 2 / 1;
    background: linear-gradient(135deg, var(--bg-alt), var(--surface-2));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .thumb-inner {
    opacity: 0.6;
  }

  .card-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .ep-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-light);
    background: var(--accent-soft);
    padding: 0.2em 0.6em;
    border-radius: 4px;
  }

  .ep-date,
  .ep-dur {
    font-size: 0.75rem;
    color: var(--slate-grey);
  }

  .ep-title {
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.3;
    margin: 0;
  }

  .ep-title-link {
    text-decoration: none;
  }

  .ep-title-link:hover {
    opacity: 0.85;
  }

  .chrome-text {
    color: var(--text);
  }

  .ep-desc {
    color: var(--text-2);
    font-size: 0.85rem;
    line-height: 1.5;
    margin: 0;
    flex: 1;
  }

  .btn-outline-sm {
    display: inline-block;
    padding: 0.45rem 1rem;
    border: 1px solid var(--accent-border);
    border-radius: 100px;
    color: var(--accent-dim);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 600;
    transition: border-color 0.2s, color 0.2s;
    align-self: flex-start;
  }

  .btn-outline-sm:hover {
    border-color: var(--accent);
    color: var(--accent-light);
  }
</style>
