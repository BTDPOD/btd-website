---
const navLinks = [
  { href: '/episodes', label: 'Episodes' },
  { href: '/guests', label: 'Guests' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const currentPath = Astro.url.pathname;
---

<nav class="site-nav" id="site-nav">
  <div class="nav-inner">
    <!-- Logo left -->
    <a href="/" class="nav-logo" aria-label="Behind the Door Home">
      <img src="/btd-logo.png" alt="Behind the Door" width="50" height="48" class="nav-logo-img" />
      <span class="nav-brand">Behind The Door Podcast</span>
    </a>

    <!-- Desktop links center/right -->
    <div class="nav-links" id="nav-links">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`nav-link ${currentPath.startsWith(link.href) ? 'active' : ''}`}
        >
          {link.label}
        </a>
      ))}
      <a href="/subscribe" class="btn-chrome nav-subscribe">Subscribe</a>
    </div>

    <!-- Hamburger -->
    <button class="hamburger" id="hamburger" aria-label="Toggle menu" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: linear-gradient(180deg, #1c2931 0%, #131c21 65%, var(--bg) 100%);
    border-bottom: 1px solid var(--slate);
    backdrop-filter: blur(8px);
  }

  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav-logo-img {
    height: 48px;
    width: auto;
    object-fit: contain;
    flex-shrink: 0;
  }

  .nav-brand {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    color: var(--text-2);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 0.5rem 0.9rem;
    border: 1px solid transparent;
    border-radius: 100px;
    transition: color 0.2s, background 0.2s, border-color 0.2s;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--accent-light);
    background: var(--accent-soft);
    border-color: var(--accent-border);
  }

  .nav-subscribe {
    margin-left: 0.5rem;
    padding: 0.5rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 700;
    border-radius: 100px;
    text-decoration: none;
    background: var(--accent-gradient);
    color: var(--bg);
    transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
  }

  .nav-subscribe:hover {
    opacity: 0.95;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(170, 174, 142, 0.3);
  }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--accent-light);
    border-radius: 2px;
    transition: transform 0.3s, opacity 0.3s;
  }

  .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger.open span:nth-child(2) { opacity: 0; }
  .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 768px) {
    .nav-brand { display: none; }

    .hamburger { display: flex; }

    .nav-links {
      display: none;
      position: absolute;
      top: 70px;
      left: 0;
      right: 0;
    background: linear-gradient(180deg, #1c2931 0%, #131c21 65%, var(--bg) 100%);
    border-bottom: 1px solid var(--slate);
      flex-direction: column;
      align-items: stretch;
      padding: 1rem 1.5rem;
      gap: 0.5rem;
    }

    .nav-links.open { display: flex; }

    .nav-link {
      padding: 0.75rem 1rem;
      font-size: 1rem;
    }

    .nav-subscribe {
      margin-left: 0;
      text-align: center;
      padding: 0.75rem 1rem;
    }
  }
</style>

<script>
  const hamburger = document.getElementById('hamburger');
  const navLinks = document.getElementById('nav-links');

  hamburger?.addEventListener('click', () => {
    const isOpen = navLinks?.classList.toggle('open');
    hamburger.classList.toggle('open', isOpen);
    hamburger.setAttribute('aria-expanded', String(isOpen));
  });
</script>
