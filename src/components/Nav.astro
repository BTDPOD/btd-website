---
const navLinks = [
  { href: '/episodes', label: 'Episodes' },
  { href: '/guests', label: 'Guests' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const currentPath = Astro.url.pathname;
---

<nav class="site-nav" id="site-nav">
  <div class="nav-inner">
    <!-- Logo left -->
    <a href="/" class="nav-logo" aria-label="Behind the Door Home">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="44" height="44" aria-hidden="true">
        <defs>
          <radialGradient id="navCircleGrad" cx="50%" cy="35%" r="65%">
            <stop offset="0%" stop-color="#2a2a2a"/>
            <stop offset="100%" stop-color="#0a0a0a"/>
          </radialGradient>
          <linearGradient id="navChromeBorder" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#c0c0c0"/>
            <stop offset="50%" stop-color="#e8e8e8"/>
            <stop offset="100%" stop-color="#b8b8b8"/>
          </linearGradient>
          <linearGradient id="navChromeText" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#c0c0c0"/>
            <stop offset="30%" stop-color="#ffffff"/>
            <stop offset="60%" stop-color="#a8a8a8"/>
            <stop offset="100%" stop-color="#d4d4d4"/>
          </linearGradient>
        </defs>
        <circle cx="50" cy="50" r="48" fill="url(#navChromeBorder)"/>
        <circle cx="50" cy="50" r="44" fill="url(#navCircleGrad)"/>
        <text x="50" y="50" text-anchor="middle" dominant-baseline="middle"
              font-family="Arial Black, Arial, sans-serif" font-weight="900"
              font-size="22" fill="url(#navChromeText)" letter-spacing="1">BTD</text>
        <g stroke="url(#navChromeText)" stroke-width="1.5" opacity="0.7">
          <line x1="22" y1="64" x2="78" y2="64"/>
          <line x1="22" y1="69" x2="78" y2="69"/>
          <line x1="22" y1="74" x2="78" y2="74"/>
          <line x1="37" y1="64" x2="37" y2="74"/>
          <line x1="50" y1="64" x2="50" y2="74"/>
          <line x1="63" y1="64" x2="63" y2="74"/>
        </g>
      </svg>
      <span class="nav-brand">Behind the Door</span>
    </a>

    <!-- Desktop links center/right -->
    <div class="nav-links" id="nav-links">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`nav-link ${currentPath.startsWith(link.href) ? 'active' : ''}`}
        >
          {link.label}
        </a>
      ))}
      <a href="/subscribe" class="btn-chrome nav-subscribe">Subscribe</a>
    </div>

    <!-- Hamburger -->
    <button class="hamburger" id="hamburger" aria-label="Toggle menu" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #16181a;
    border-bottom: 1px solid #2e3032;
    backdrop-filter: blur(8px);
  }

  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav-brand {
    font-size: 1.1rem;
    font-weight: 800;
    background: linear-gradient(135deg, #c0c0c0 0%, #ffffff 20%, #a8a8a8 40%, #e8e8e8 60%, #909090 80%, #d4d4d4 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.02em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    color: #a0a4a8;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    transition: color 0.2s, background 0.2s;
  }

  .nav-link:hover,
  .nav-link.active {
    color: #e8e8e8;
    background: rgba(255,255,255,0.05);
  }

  .nav-subscribe {
    margin-left: 0.5rem;
    padding: 0.5rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 700;
    border-radius: 6px;
    text-decoration: none;
    background: linear-gradient(135deg, #c0c0c0 0%, #e8e8e8 25%, #a8a8a8 50%, #d4d4d4 75%, #b8b8b8 100%);
    color: #1a1c1e;
    transition: opacity 0.2s, transform 0.15s;
  }

  .nav-subscribe:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: #c0c0c0;
    border-radius: 2px;
    transition: transform 0.3s, opacity 0.3s;
  }

  .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger.open span:nth-child(2) { opacity: 0; }
  .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 768px) {
    .nav-brand { display: none; }

    .hamburger { display: flex; }

    .nav-links {
      display: none;
      position: absolute;
      top: 70px;
      left: 0;
      right: 0;
      background: #16181a;
      border-bottom: 1px solid #2e3032;
      flex-direction: column;
      align-items: stretch;
      padding: 1rem 1.5rem;
      gap: 0.5rem;
    }

    .nav-links.open { display: flex; }

    .nav-link {
      padding: 0.75rem 1rem;
      font-size: 1rem;
    }

    .nav-subscribe {
      margin-left: 0;
      text-align: center;
      padding: 0.75rem 1rem;
    }
  }
</style>

<script>
  const hamburger = document.getElementById('hamburger');
  const navLinks = document.getElementById('nav-links');

  hamburger?.addEventListener('click', () => {
    const isOpen = navLinks?.classList.toggle('open');
    hamburger.classList.toggle('open', isOpen);
    hamburger.setAttribute('aria-expanded', String(isOpen));
  });
</script>
