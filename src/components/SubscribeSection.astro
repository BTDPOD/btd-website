---
import PlatformBadge from './PlatformBadge.astro';
---

<section class="subscribe-section">
  <div class="subscribe-inner">
    <div class="subscribe-header">
      <span class="eyebrow">Never Miss an Episode</span>
      <h2 class="section-title chrome-text">Listen on Your Favorite Platform</h2>
      <p class="section-sub">Behind the Door is available everywhere you listen to podcasts.</p>
    </div>

    <div class="platform-grid">
      <PlatformBadge platform="apple" size="lg" />
      <PlatformBadge platform="spotify" size="lg" />
      <PlatformBadge platform="youtube" size="lg" />
      <PlatformBadge platform="rss" size="lg" />
    </div>

    <div class="email-section">
      <h3 class="email-title">Get Notified When New Episodes Drop</h3>
      <p class="email-sub">No spam. Just a heads up when something worth hearing lands.</p>
      <form class="email-form" action="https://btdpodcast.net/subscribe" method="post" netlify>
        <input type="hidden" name="form-name" value="newsletter" />
        <div class="form-row">
          <input
            type="email"
            name="email"
            placeholder="your@email.com"
            class="email-input"
            required
            aria-label="Email address"
          />
          <button type="submit" class="btn-chrome">Notify Me</button>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .subscribe-section {
    background: var(--bg-alt);
    padding: 6rem 1.5rem;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .subscribe-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .subscribe-header {
    text-align: center;
  }

  .eyebrow {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 900;
    margin: 0 0 0.75rem;
  }

  .chrome-text {
    color: var(--text);
  }

  .section-sub {
    color: var(--text-dim);
    font-size: 1rem;
    margin: 0;
  }

  .platform-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .email-section {
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2.5rem;
    text-align: center;
  }

  .email-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text);
    margin: 0 0 0.5rem;
  }

  .email-sub {
    color: var(--text-dim);
    font-size: 0.9rem;
    margin: 0 0 1.5rem;
  }

  .email-form { display: flex; justify-content: center; }

  .form-row {
    display: flex;
    gap: 0.75rem;
    width: 100%;
    max-width: 480px;
  }

  .email-input {
    flex: 1;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s;
  }

  .email-input::placeholder { color: var(--slate-grey); }
  .email-input:focus { border-color: var(--text-2); }

  .btn-chrome {
    padding: 0.75rem 1.5rem;
    background: var(--accent-gradient);
    color: var(--bg);
    font-weight: 800;
    font-size: 0.9rem;
    border: none;
    border-radius: 100px;
    cursor: pointer;
    font-family: inherit;
    transition: opacity 0.2s, transform 0.15s;
    white-space: nowrap;
  }

  .btn-chrome:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  @media (max-width: 900px) {
    .platform-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 560px) {
    .platform-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .form-row { flex-direction: column; }
    .email-section { padding: 1.75rem 1.25rem; }
  }
</style>
