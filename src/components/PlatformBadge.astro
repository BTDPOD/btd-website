const p = platforms[platform];
---

{p && (
  <a
    href={p.url}
    target="_blank"
    rel="noopener noreferrer"
    class={`platform-badge size-${size}`}
    aria-label={`Listen on ${p.label}`}
  >
    <span class="badge-icon" set:html={p.icon} />
    <span class="badge-label">{p.label}</span>
    {size === 'lg' && p.desc && <span class="badge-desc">{p.desc}</span>}
  </a>
)}

<style>
  .platform-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    border-radius: 8px;
    transition: background 0.2s, border-color 0.2s, transform 0.15s;
    white-space: nowrap;
  }

  .size-sm {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-2);
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .size-sm:hover {
    border-color: var(--text-2);
    background: var(--border);
    transform: translateY(-1px);
  }

  .size-lg {
    background: var(--bg-alt);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 1.25rem 1.5rem;
    font-size: 1rem;
    font-weight: 700;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.375rem;
    width: 100%;
  }

  .size-lg:hover {
    border-color: var(--text-2);
    background: var(--surface);
    transform: translateY(-2px);
  }

  .badge-icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    color: var(--text-2);
  }

  .size-lg .badge-icon {
    width: 32px;
    height: 32px;
  }

  .size-lg .badge-icon :global(svg) {
    width: 28px;
    height: 28px;
  }

  .badge-label {
    font-weight: 700;
  }

  .badge-desc {
    font-size: 0.8rem;
    color: var(--text-dim);
    font-weight: 400;
  }
</style>
