---
import Layout from '../layouts/Layout.astro';
import PlatformBadge from '../components/PlatformBadge.astro';
---

<Layout
  title="Subscribe — Behind the Door Podcast"
  description="Listen to Behind the Door on Apple Podcasts, Spotify, YouTube, Amazon Music, and more. Subscribe to never miss a new episode."
>
  <section class="subscribe-hero noise-overlay">
    <div class="container">
      <span class="eyebrow">Never Miss an Episode</span>
      <h1 class="page-title chrome-text">Listen Anywhere.</h1>
      <p class="page-sub">
        Behind the Door is on every major podcast platform. Pick your favorite and hit subscribe —
        new episodes will show up automatically.
      </p>
    </div>
  </section>

  <section class="platforms-section">
    <div class="container">
      <h2 class="section-title chrome-text">Choose Your Platform</h2>
      <div class="platforms-grid-lg">
        <!-- Apple Podcasts -->
        <a href="https://podcasts.apple.com/search?term=behind+the+door+podcast" target="_blank" rel="noopener noreferrer" class="platform-card">
          <div class="platform-icon">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
          </div>
          <div class="platform-info">
            <div class="platform-name">Apple Podcasts</div>
            <div class="platform-desc">The #1 podcast app on iOS. Subscribe and auto-download new episodes.</div>
          </div>
          <div class="platform-arrow">&rarr;</div>
        </a>

        <!-- Spotify -->
        <a href="https://open.spotify.com/search/behind%20the%20door%20podcast" target="_blank" rel="noopener noreferrer" class="platform-card">
          <div class="platform-icon">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
          </div>
          <div class="platform-info">
            <div class="platform-name">Spotify</div>
            <div class="platform-desc">Stream or download on Spotify. Available on all devices.</div>
          </div>
          <div class="platform-arrow">&rarr;</div>
        </a>

        <!-- YouTube -->
        <a href="https://youtube.com/search?q=behind+the+door+podcast" target="_blank" rel="noopener noreferrer" class="platform-card">
          <div class="platform-icon">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </div>
          <div class="platform-info">
            <div class="platform-name">YouTube</div>
            <div class="platform-desc">Watch the full video version of every episode. Subscribe to the channel.</div>
          </div>
          <div class="platform-arrow">&rarr;</div>
        </a>

        <!-- Amazon Music -->
        <a href="https://music.amazon.com/podcasts/search?keywords=behind+the+door" target="_blank" rel="noopener noreferrer" class="platform-card">
          <div class="platform-icon">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor"><path d="M.045 18.02c.072-.116.187-.127.304-.076 3.849 2.01 7.97 2.89 12.17 2.537 2.95-.25 5.77-1.03 8.44-2.37.186-.097.369-.063.468.145.098.209.002.39-.185.487-2.87 1.48-5.89 2.35-9.04 2.66-4.39.43-8.63-.36-12.7-2.45-.194-.1-.244-.308-.147-.55l-.31.117z"/></svg>
          </div>
          <div class="platform-info">
            <div class="platform-name">Amazon Music</div>
            <div class="platform-desc">Listen free with Amazon Music or Audible. Works with Alexa.</div>
          </div>
          <div class="platform-arrow">&rarr;</div>
        </a>

        <!-- Google Podcasts -->
        <a href="https://podcasts.google.com/search/behind%20the%20door" target="_blank" rel="noopener noreferrer" class="platform-card">
          <div class="platform-icon">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor"><path d="M12.25 0A12.25 12.25 0 0 0 0 12.25a12.25 12.25 0 0 0 12.25 12.25 12.25 12.25 0 0 0 12.25-12.25A12.25 12.25 0 0 0 12.25 0zm0 4.5a2.25 2.25 0 0 1 2.25 2.25v5a2.25 2.25 0 0 1-2.25 2.25 2.25 2.25 0 0 1-2.25-2.25v-5A2.25 2.25 0 0 1 12.25 4.5zm0 11a2.25 2.25 0 0 1 2.25 2.25 2.25 2.25 0 0 1-2.25 2.25 2.25 2.25 0 0 1-2.25-2.25 2.25 2.25 0 0 1 2.25-2.25zm-5-7.75a2.25 2.25 0 0 1 2.25 2.25 2.25 2.25 0 0 1-2.25 2.25A2.25 2.25 0 0 1 5 10a2.25 2.25 0 0 1 2.25-2.25zm10 0A2.25 2.25 0 0 1 19.5 10a2.25 2.25 0 0 1-2.25 2.25A2.25 2.25 0 0 1 15 10a2.25 2.25 0 0 1 2.25-2.25z"/></svg>
          </div>
          <div class="platform-info">
            <div class="platform-name">Google Podcasts</div>
            <div class="platform-desc">Listen on Android and the web. Syncs across all your devices.</div>
          </div>
          <div class="platform-arrow">&rarr;</div>
        </a>

        <!-- Pocket Casts -->
        <a href="https://pca.st/search?q=behind+the+door" target="_blank" rel="noopener noreferrer" class="platform-card">
          <div class="platform-icon">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zm0 4.5c4.142 0 7.5 3.358 7.5 7.5s-3.358 7.5-7.5 7.5S4.5 16.142 4.5 12 7.858 4.5 12 4.5zm0 2.5c-2.761 0-5 2.239-5 5s2.239 5 5 5 5-2.239 5-5-2.239-5-5-5zm0 2.5c1.381 0 2.5 1.119 2.5 2.5S13.381 14.5 12 14.5 9.5 13.381 9.5 12s1.119-2.5 2.5-2.5z"/></svg>
          </div>
          <div class="platform-info">
            <div class="platform-name">Pocket Casts</div>
            <div class="platform-desc">The best podcast app for power listeners. Available on iOS and Android.</div>
          </div>
          <div class="platform-arrow">&rarr;</div>
        </a>

        <!-- Overcast -->
        <a href="https://overcast.fm/search?q=behind+the+door" target="_blank" rel="noopener noreferrer" class="platform-card">
          <div class="platform-icon">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm0 4.2c4.308 0 7.8 3.492 7.8 7.8s-3.492 7.8-7.8 7.8S4.2 16.308 4.2 12 7.692 4.2 12 4.2zm0 1.8c-3.315 0-6 2.685-6 6s2.685 6 6 6 6-2.685 6-6-2.685-6-6-6zm.9 2.4V12l3 1.8-.9 1.5L12 13.2V8.4h.9z"/></svg>
          </div>
          <div class="platform-info">
            <div class="platform-name">Overcast</div>
            <div class="platform-desc">iOS podcast app with Smart Speed and Voice Boost. Highly rated.</div>
          </div>
          <div class="platform-arrow">&rarr;</div>
        </a>

        <!-- RSS -->
        <a href="https://feeds.transistor.fm/behind-the-door" target="_blank" rel="noopener noreferrer" class="platform-card">
          <div class="platform-icon">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/></svg>
          </div>
          <div class="platform-info">
            <div class="platform-name">RSS Feed</div>
            <div class="platform-desc">Add to any podcast app manually. The universal way to subscribe.</div>
          </div>
          <div class="platform-arrow">&rarr;</div>
        </a>
      </div>
    </div>
  </section>

  <!-- Email signup -->
  <section class="email-section noise-overlay">
    <div class="container">
      <div class="email-inner">
        <div class="email-text">
          <h2 class="email-title chrome-text">Get Email Alerts</h2>
          <p>
            Prefer email? Drop your address below and we'll send you a quick note when a
            new episode drops. That's it. No spam. No weekly newsletters. Just the alert.
          </p>
        </div>
        <form class="email-form" name="newsletter" method="POST" netlify>
          <input type="hidden" name="form-name" value="newsletter" />
          <div class="form-row">
            <input type="text" name="name" placeholder="Your first name" class="email-input" />
            <input type="email" name="email" placeholder="your@email.com" class="email-input" required />
            <button type="submit" class="btn-chrome">Notify Me</button>
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style>
  .container { max-width: 1100px; margin: 0 auto; }

  .subscribe-hero {
    background: linear-gradient(160deg, #16181a, #1e2022);
    padding: 5rem 1.5rem 4rem;
    border-bottom: 1px solid #2e3032;
  }

  .eyebrow {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #6a6e72;
    margin-bottom: 0.75rem;
  }

  .page-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 900;
    margin: 0 0 1rem;
    line-height: 1;
  }

  .chrome-text {
    background: linear-gradient(135deg, #c0c0c0 0%, #ffffff 20%, #a8a8a8 40%, #e8e8e8 60%, #909090 80%, #d4d4d4 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .page-sub {
    color: #6a6e72;
    font-size: 1rem;
    max-width: 500px;
    line-height: 1.65;
    margin: 0;
  }

  .platforms-section {
    padding: 4rem 1.5rem 5rem;
  }

  .section-title {
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 900;
    margin: 0 0 2.5rem;
    text-align: center;
  }

  .platforms-grid-lg {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .platform-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: #1e2022;
    border: 1px solid #2e3032;
    border-radius: 12px;
    padding: 1.5rem;
    text-decoration: none;
    transition: border-color 0.25s, background 0.2s, transform 0.15s;
  }

  .platform-card:hover {
    border-color: #7a7e82;
    background: #242628;
    transform: translateY(-2px);
  }

  .platform-icon {
    width: 60px;
    height: 60px;
    background: rgba(192,192,192,0.07);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #c0c0c0;
    flex-shrink: 0;
  }

  .platform-info { flex: 1; }

  .platform-name {
    font-size: 1rem;
    font-weight: 800;
    color: #d4d4d4;
    margin-bottom: 0.25rem;
  }

  .platform-desc {
    font-size: 0.8rem;
    color: #5a5e62;
    line-height: 1.45;
  }

  .platform-arrow {
    color: #3a3e42;
    font-size: 1.25rem;
    transition: color 0.2s, transform 0.2s;
  }

  .platform-card:hover .platform-arrow {
    color: #8a8e92;
    transform: translateX(4px);
  }

  /* Email section */
  .email-section {
    background: linear-gradient(160deg, #16181a, #1e2022);
    padding: 5rem 1.5rem;
    border-top: 1px solid #2e3032;
  }

  .email-inner {
    display: flex;
    align-items: center;
    gap: 4rem;
    flex-wrap: wrap;
  }

  .email-text {
    flex: 1;
    min-width: 280px;
  }

  .email-title {
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 900;
    margin: 0 0 0.875rem;
  }

  .email-text p {
    color: #6a6e72;
    line-height: 1.65;
    font-size: 0.95rem;
    margin: 0;
    max-width: 440px;
  }

  .email-form {
    flex: 1;
    min-width: 280px;
  }

  .form-row {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .email-input {
    background: #16181a;
    border: 1px solid #3a3c3e;
    border-radius: 8px;
    color: #e0e2e4;
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s;
  }

  .email-input::placeholder { color: #3a3e42; }
  .email-input:focus { border-color: #7a7e82; }

  .btn-chrome {
    padding: 0.875rem;
    background: linear-gradient(135deg, #c0c0c0 0%, #e8e8e8 25%, #a8a8a8 50%, #d4d4d4 75%, #b8b8b8 100%);
    color: #1a1c1e;
    font-weight: 800;
    font-size: 0.95rem;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-family: inherit;
    transition: opacity 0.2s, transform 0.15s;
  }

  .btn-chrome:hover { opacity: 0.9; transform: translateY(-1px); }

  @media (max-width: 768px) {
    .platforms-grid-lg { grid-template-columns: 1fr; }
    .email-inner { flex-direction: column; gap: 2.5rem; }
    .email-text, .email-form { min-width: 0; width: 100%; }
  }
</style>
