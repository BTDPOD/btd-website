---
import Layout from '../../layouts/Layout.astro';
import EpisodeCard from '../../components/EpisodeCard.astro';
import { fetchEpisodes, formatDate, formatDuration } from '../../lib/rss';

export async function getStaticPaths() {
  const episodes = await fetchEpisodes();
  return episodes.map((ep) => ({
    params: { slug: ep.slug },
    props: { episode: ep, allEpisodes: episodes },
  }));
}

const { episode, allEpisodes } = Astro.props;

const related = allEpisodes
  .filter((ep) => ep.guid !== episode.guid)
  .slice(0, 3);
---

<Layout
  title={`${episode.title} — Behind the Door Podcast`}
  description={episode.description.slice(0, 160)}
  ogImage={episode.image}
>
  <article class="episode-page">
    <!-- Hero -->
    <div class="ep-hero">
      <div class="container">
        <a href="/episodes" class="back-link">&larr; All Episodes</a>
        <div class="ep-hero-inner">
          <div class="ep-artwork">
            {episode.image ? (
              <img src={episode.image} alt={episode.title} width="400" height="400" loading="eager" />
            ) : (
              <div class="artwork-placeholder">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100" height="100">
                  <defs>
                    <linearGradient id="slugChrome" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#c0c0c0"/>
                      <stop offset="50%" stop-color="#e8e8e8"/>
                      <stop offset="100%" stop-color="#909090"/>
                    </linearGradient>
                  </defs>
                  <circle cx="50" cy="50" r="48" fill="url(#slugChrome)"/>
                  <circle cx="50" cy="50" r="44" fill="#111"/>
                  <text x="50" y="50" text-anchor="middle" dominant-baseline="middle"
                        font-family="Arial Black" font-weight="900" font-size="22"
                        fill="url(#slugChrome)" letter-spacing="1">BTD</text>
                </svg>
              </div>
            )}
          </div>
          <div class="ep-header">
            <div class="ep-meta">
              {episode.episodeNumber && <span class="ep-badge">Episode {episode.episodeNumber}</span>}
              {episode.pubDate && <span class="ep-date">{formatDate(episode.pubDate)}</span>}
              {episode.duration && (
                <span class="ep-dur">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: -2px; margin-right: 3px;"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm.5 5v5.25l4.5 2.67-.75 1.23L11 13V7h1.5z"/></svg>
                  {formatDuration(episode.duration)}
                </span>
              )}
            </div>
            <h1 class="ep-title chrome-text">{episode.title}</h1>
            <p class="ep-host">with <strong>Kaleb Blyton</strong></p>
            <div class="ep-actions">
              {episode.audioUrl && (
                <a href={episode.audioUrl} class="btn-chrome" target="_blank" rel="noopener">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: -2px; margin-right: 6px;"><path d="M8 5v14l11-7z"/></svg>
                  Listen Now
                </a>
              )}
              {episode.link && (
                <a href={episode.link} class="btn-outline" target="_blank" rel="noopener">Original Link</a>
              )}
              <button class="btn-share" id="share-btn" aria-label="Share episode">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                Share
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Audio player -->
    {episode.audioUrl && (
      <div class="player-bar">
        <div class="container">
          <audio controls class="audio-player" preload="metadata">
            <source src={episode.audioUrl} type="audio/mpeg" />
            Your browser does not support the audio element.
          </audio>
        </div>
      </div>
    )}

    <!-- Show notes -->
    <div class="ep-body">
      <div class="container ep-body-grid">
        <div class="ep-notes">
          <h2 class="notes-title">Show Notes</h2>
          {episode.description ? (
            <div class="notes-content">
              {episode.description.split('\n').filter(Boolean).map(para => (
                <p>{para}</p>
              ))}
            </div>
          ) : (
            <p class="no-notes">Show notes not available for this episode.</p>
          )}
        </div>
        <aside class="ep-sidebar">
          <div class="sidebar-card">
            <h3>About the Host</h3>
            <div class="sidebar-host">
              <div class="host-avatar-lg">KB</div>
              <div>
                <div class="host-name">Kaleb Blyton</div>
                <div class="host-desc">Host of Behind the Door — conversations from the trades, for the trades.</div>
              </div>
            </div>
          </div>
          <div class="sidebar-card">
            <h3>Subscribe</h3>
            <p class="sidebar-sub">Never miss a new episode.</p>
            <div class="sidebar-platforms">
              <a href="https://podcasts.apple.com/search?term=behind+the+door+podcast" target="_blank" rel="noopener" class="platform-pill">Apple Podcasts</a>
              <a href="https://open.spotify.com/search/behind%20the%20door%20podcast" target="_blank" rel="noopener" class="platform-pill">Spotify</a>
              <a href="https://feeds.transistor.fm/behind-the-door" target="_blank" rel="noopener" class="platform-pill">RSS</a>
            </div>
          </div>
          <div class="sidebar-card">
            <h3>Share This Episode</h3>
            <div class="share-links">
              <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(episode.title + ' — Behind the Door Podcast')}&url=${encodeURIComponent('https://btdpodcast.net/episodes/' + episode.slug)}`} target="_blank" rel="noopener" class="share-btn">Twitter/X</a>
              <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent('https://btdpodcast.net/episodes/' + episode.slug)}`} target="_blank" rel="noopener" class="share-btn">Facebook</a>
              <a href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent('https://btdpodcast.net/episodes/' + episode.slug)}`} target="_blank" rel="noopener" class="share-btn">LinkedIn</a>
            </div>
          </div>
        </aside>
      </div>
    </div>

    <!-- Related episodes -->
    {related.length > 0 && (
      <section class="related-section">
        <div class="container">
          <h2 class="related-title chrome-text">More Episodes</h2>
          <div class="related-grid">
            {related.map((ep, i) => <EpisodeCard episode={ep} index={i} />)}
          </div>
        </div>
      </section>
    )}
  </article>
</Layout>

<style>
  .container { max-width: 1100px; margin: 0 auto; }

  .back-link {
    display: inline-block;
    color: #6a6e72;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    margin-bottom: 2rem;
    transition: color 0.2s;
  }

  .back-link:hover { color: #c0c0c0; }

  /* Hero */
  .ep-hero {
    background: linear-gradient(160deg, #16181a, #1e2022);
    padding: 3rem 1.5rem 2rem;
    border-bottom: 1px solid #2e3032;
  }

  .ep-hero-inner {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3rem;
    align-items: start;
  }

  .ep-artwork {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #3a3c3e;
    aspect-ratio: 1;
  }

  .ep-artwork img { width: 100%; height: 100%; object-fit: cover; }

  .artwork-placeholder {
    width: 100%;
    height: 100%;
    background: #111;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 240px;
  }

  .ep-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .ep-badge {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #a8a8a8;
    background: rgba(168,168,168,0.1);
    padding: 0.25em 0.75em;
    border-radius: 4px;
  }

  .ep-date, .ep-dur { color: #5a5e62; font-size: 0.8rem; }

  .ep-title {
    font-size: clamp(1.4rem, 3vw, 2.25rem);
    font-weight: 900;
    line-height: 1.15;
    margin: 0 0 0.75rem;
  }

  .chrome-text {
    background: linear-gradient(135deg, #c0c0c0 0%, #ffffff 20%, #a8a8a8 40%, #e8e8e8 60%, #909090 80%, #d4d4d4 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .ep-host { color: #5a5e62; font-size: 0.875rem; margin: 0 0 1.5rem; }
  .ep-host strong { color: #8a8e92; }

  .ep-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .btn-chrome {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    background: var(--accent-gradient);
    color: #1a1c1e;
    font-weight: 800;
    font-size: 0.9rem;
    border-radius: 100px;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.15s;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }

  .btn-chrome:hover { opacity: 0.9; transform: translateY(-1px); }

  .btn-outline {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--accent-border);
    color: var(--accent-dim);
    font-weight: 700;
    font-size: 0.9rem;
    border-radius: 100px;
    text-decoration: none;
    transition: border-color 0.2s;
  }

  .btn-outline:hover { border-color: var(--accent); }

  .btn-share {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.75rem 1rem;
    background: none;
    border: 1px solid #3a3c3e;
    color: #8a8e92;
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: 100px;
    cursor: pointer;
    font-family: inherit;
    transition: border-color 0.2s, color 0.2s;
  }

  .btn-share:hover { border-color: #7a7e82; color: var(--accent-dim); }

  /* Player bar */
  .player-bar {
    background: #16181a;
    border-bottom: 1px solid #2e3032;
    padding: 1.25rem 1.5rem;
  }

  .audio-player {
    width: 100%;
    height: 48px;
    filter: invert(0.85) hue-rotate(180deg) brightness(0.9);
    border-radius: 8px;
  }

  /* Body */
  .ep-body {
    padding: 4rem 1.5rem;
  }

  .ep-body-grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 4rem;
    align-items: start;
  }

  .notes-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #e8e8e8;
    margin: 0 0 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #2e3032;
  }

  .notes-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .notes-content p {
    color: #7a7e82;
    line-height: 1.75;
    font-size: 0.95rem;
  }

  .no-notes {
    color: #4a4e52;
    font-style: italic;
  }

  /* Sidebar */
  .ep-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: sticky;
    top: 90px;
  }

  .sidebar-card {
    background: #1e2022;
    border: 1px solid #2e3032;
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .sidebar-card h3 {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6a6e72;
    margin: 0;
  }

  .sidebar-host {
    display: flex;
    gap: 0.875rem;
    align-items: center;
  }

  .host-avatar-lg {
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, #c0c0c0, #707070);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 0.85rem;
    color: #1a1c1e;
    flex-shrink: 0;
  }

  .host-name { font-weight: 700; color: #c0c0c0; font-size: 0.9rem; }
  .host-desc { font-size: 0.8rem; color: #5a5e62; line-height: 1.4; margin-top: 0.2rem; }

  .sidebar-sub { color: #5a5e62; font-size: 0.8rem; margin: 0; }

  .sidebar-platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .platform-pill {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    background: #242628;
    border: 1px solid #3a3c3e;
    border-radius: 100px;
    color: #a0a4a8;
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }

  .platform-pill:hover { border-color: #7a7e82; color: #c0c0c0; }

  .share-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .share-btn {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    background: none;
    border: 1px solid #2e3032;
    border-radius: 6px;
    color: #6a6e72;
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }

  .share-btn:hover { border-color: #5a5e62; color: #a0a4a8; }

  /* Related */
  .related-section {
    padding: 4rem 1.5rem;
    border-top: 1px solid #2e3032;
    background: #16181a;
  }

  .related-title {
    font-size: 1.5rem;
    font-weight: 900;
    margin: 0 0 2rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .ep-hero-inner { grid-template-columns: 1fr; }
    .ep-artwork { max-width: 240px; }
    .ep-body-grid { grid-template-columns: 1fr; }
    .ep-sidebar { position: static; }
    .related-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 560px) {
    .related-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  const shareBtn = document.getElementById('share-btn');
  shareBtn?.addEventListener('click', async () => {
    if (navigator.share) {
      try {
        await navigator.share({
          title: document.title,
          url: window.location.href,
        });
      } catch (e) { /* user cancelled */ }
    } else {
      await navigator.clipboard.writeText(window.location.href);
      shareBtn.textContent = 'Link Copied!';
      setTimeout(() => shareBtn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg> Share`, 2000);
    }
  });
</script>
