---
import Layout from '../../layouts/Layout.astro';
import EpisodeCard from '../../components/EpisodeCard.astro';
import { fetchEpisodes } from '../../lib/rss';

const episodes = await fetchEpisodes();
---

<Layout
  title="All Episodes — Behind the Door Podcast"
  description="Browse all episodes of Behind the Door, the podcast for the trades. Real conversations with home service business owners, world-class technicians, and people who built something real."
>
  <div class="episodes-hero noise-overlay">
    <div class="container">
      <span class="eyebrow">The Archive</span>
      <h1 class="page-title chrome-text">All Episodes</h1>
      <p class="page-sub">
        Every conversation. Every story. Every truth they never put on the highlight reel.
      </p>
    </div>
  </div>

  <section class="episodes-section">
    <div class="container">
      {episodes.length > 0 ? (
        <>
          <div class="episodes-toolbar">
            <span class="ep-count">{episodes.length} episode{episodes.length !== 1 ? 's' : ''}</span>
            <span class="sort-label">Newest first</span>
          </div>
          <div class="episodes-grid">
            {episodes.map((ep, i) => (
              <EpisodeCard episode={ep} index={i} />
            ))}
          </div>
        </>
      ) : (
        <div class="empty-state">
          <div class="empty-icon">
            <img src="/btd-logo.png" alt="Behind the Door" width="120" class="btd-mark" loading="lazy" />
          </div>
          <h2 class="empty-title chrome-text">Episodes Coming Soon</h2>
          <p class="empty-sub">
            No episodes yet — check back soon. The first real conversation is on its way.
            Subscribe so you don't miss the drop.
          </p>
          <a href="/subscribe" class="btn-chrome">Subscribe Now</a>
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .container { max-width: 1200px; margin: 0 auto; }

  .episodes-hero {
    background: linear-gradient(160deg, var(--bg-alt) 0%, var(--bg-alt) 100%);
    padding: 5rem 1.5rem 4rem;
    border-bottom: 1px solid var(--border);
  }

  .eyebrow {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 0.75rem;
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 900;
    margin: 0 0 0.75rem;
  }

  .chrome-text {
    color: var(--text);
  }

  .page-sub {
    color: var(--text-dim);
    font-size: 1rem;
    max-width: 560px;
    margin: 0;
  }

  .episodes-section {
    padding: 3rem 1.5rem 6rem;
  }

  .episodes-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .ep-count {
    color: var(--text-dim);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .sort-label {
    color: var(--slate-grey);
    font-size: 0.8rem;
  }

  .episodes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  /* Empty state */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 5rem 1.5rem;
    gap: 1.5rem;
  }

  .empty-icon { opacity: 0.5; }

  .empty-title {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 900;
    margin: 0;
  }

  .empty-sub {
    color: var(--text-dim);
    font-size: 1rem;
    max-width: 440px;
    line-height: 1.65;
    margin: 0;
  }

  .btn-chrome {
    display: inline-block;
    padding: 0.875rem 2rem;
    background: var(--accent-gradient);
    color: var(--bg);
    font-weight: 800;
    border-radius: 100px;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.15s;
  }

  .btn-chrome:hover { opacity: 0.9; transform: translateY(-1px); }

  @media (max-width: 900px) {
    .episodes-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .episodes-grid { grid-template-columns: 1fr; }
  }
</style>
